{
  "name": "nomba-ts",
  "version": "1.0.0",
  "description": "Unofficial TypeScript SDK for the Nomba payments API",
  "license": "MIT",
  "author": "Righteousness <righteousness@example.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/data/nomba_openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "nomba",
    "payment",
    "payments",
    "api",
    "sdk",
    "typescript",
    "nigeria",
    "fintech"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/righteousness/nomba-ts.git"
  },
  "bugs": {
    "url": "https://github.com/righteousness/nomba-ts/issues"
  },
  "homepage": "https://nomba-ts.vercel.app",
  "dependencies": {
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
